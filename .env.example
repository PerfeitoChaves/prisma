# ==============================================================================
# FATOS CRUZADOS — CONFIGURAÇÕES DE IA (100% OPCIONAL)
# ==============================================================================
# O sistema funciona 100% de forma local, offline e gratuita com nosso motor
# de PLN extrativo determinístico (sem custos e sem depender de provedor externo).
#
# Caso queira resumos gerativos via LLM usando cotas gratuitas, basta preencher:
#
# 1. Google Gemini Flash (Cota 100% gratuita no Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=

# 2. Groq Free Tier (Llama 3.3 70B gratuito no Groq Console: https://console.groq.com)
GROQ_API_KEY=

# 3. Ollama local (se você tiver instalado na sua máquina)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
USE_OLLAMA=auto

# ==============================================================================
# CARTOGRAFIA & MAPAS (100% OPCIONAL — NÃO É NECESSÁRIA PARA O MAPA FUNCIONAR)
# ==============================================================================
# O mapa tático já usa os tiles públicos e abertos do CartoDB Dark Matter gratuitamente.
# Caso você tenha uma conta empresarial ou chave própria da CARTO, preencha abaixo:
VITE_CARTO_API_KEY=
